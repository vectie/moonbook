///|
async test "ordinary load and build produce offline search and refresh it from authored chapters" {
  let root = match @env.get_env_var("MOONBOOK_STATIC_SEARCH_EVIDENCE") {
    Some(path) => path + "/book"
    None => @fs.tmpdir(prefix="moonbook-static-search-")
  }
  if !@fs.exists(root + "/src/nested") {
    @fs.mkdir(root + "/src/nested", recursive=true)
  }
  let summary = "# Summary\n\n- [Aurora plan](intro.md)\n  - [Capacity 東京](nested/README.md)\n- [Draft]()\n- [Literal syntax](syntax.md)\n"
  let plan = "# Aurora plan\n\nThe pilot needs twelve onboarding teams.\n"
  let capacity = "# Capacity 東京\n\nCapacity supports eight teams. 完全な記録 😀\n"
  let syntax = "# Literal syntax\n\nFind [a+b] literally. </script><script>bad()</script>\n"
  for
    (path, content) in [
      ("src/SUMMARY.md", summary),
      ("src/intro.md", plan),
      ("src/nested/README.md", capacity),
      ("src/syntax.md", syntax),
      ("src/unlisted.md", "Unlisted private note must not be indexed."),
      ("book.toml", "[book]\ntitle = \"Aurora synthetic handbook\"\n"),
    ] {
    @fs.write_file(root + "/" + path, content, create_mode=CreateOrTruncate)
  }
  let loaded = @driver.load(root)
  loaded.build()
  let generated = root + "/book/__moonbook/search.html"
  let first = @fs.read_file(generated).text()
  assert_true(first.contains("twelve onboarding teams"))
  assert_true(first.contains("../nested/index.html"))
  assert_false(first.contains("Unlisted private note"))
  assert_false(first.contains("Excluded draft"))
  assert_true(
    @fs.read_file(root + "/book/nested/index.html")
    .text()
    .contains("../__moonbook/search.html"),
  )
  assert_true(
    @fs.read_file(root + "/book/index.html")
    .text()
    .contains("__moonbook/search.html"),
  )
  loaded.build()
  assert_eq(@fs.read_file(generated).text(), first)
  assert_eq(@fs.read_file(root + "/src/SUMMARY.md").text(), summary)
  assert_eq(@fs.read_file(root + "/src/intro.md").text(), plan)
  assert_eq(@fs.read_file(root + "/src/nested/README.md").text(), capacity)
  assert_eq(@fs.read_file(root + "/src/syntax.md").text(), syntax)
  @fs.write_file(
    root + "/search-before.html",
    first,
    create_mode=CreateOrTruncate,
  )
  let revised = "# Aurora plan\n\nThe revised pilot needs six onboarding teams.\n"
  @fs.write_file(root + "/src/intro.md", revised, create_mode=CreateOrTruncate)
  let reloaded = @driver.load(root)
  reloaded.build()
  let second = @fs.read_file(generated).text()
  assert_true(second.contains("six onboarding teams"))
  assert_false(second.contains("twelve onboarding teams"))
  assert_eq(@fs.read_file(root + "/src/intro.md").text(), revised)
  assert_eq(
    @fs.read_file(root + "/src/unlisted.md").text(),
    "Unlisted private note must not be indexed.",
  )
  @fs.write_file(
    root + "/src/SUMMARY.md",
    summary + "- [Missing](missing.md)\n",
    create_mode=CreateOrTruncate,
  )
  assert_true((try? @driver.load(root)) is Err(_))
  assert_eq(@fs.read_file(generated).text(), second)
  assert_eq(@fs.read_file(root + "/src/intro.md").text(), revised)
  @fs.write_file(
    root + "/src/SUMMARY.md",
    summary,
    create_mode=CreateOrTruncate,
  )
}

///|
async test "reserved chapter output reports conflict without replacing any generated or source bytes" {
  let root = @fs.tmpdir(prefix="moonbook-search-conflict-")
  @fs.mkdir(root + "/src/__moonbook", recursive=true)
  @fs.mkdir(root + "/book/__moonbook", recursive=true)
  let chapter = "# Existing author chapter\nKeep me.\n"
  @fs.write_file(
    root + "/src/SUMMARY.md",
    "# Summary\n\n- [Conflict](__moonbook/search.md)\n",
    create_mode=CreateOrTruncate,
  )
  @fs.write_file(
    root + "/src/__moonbook/search.md",
    chapter,
    create_mode=CreateOrTruncate,
  )
  @fs.write_file(
    root + "/book/__moonbook/search.html",
    "old generated bytes",
    create_mode=CreateOrTruncate,
  )
  let loaded = @driver.load(root)
  assert_true((try? loaded.build()) is Err(_))
  assert_eq(@fs.read_file(root + "/src/__moonbook/search.md").text(), chapter)
  assert_eq(
    @fs.read_file(root + "/book/__moonbook/search.html").text(),
    "old generated bytes",
  )
}
