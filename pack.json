{
  "id": "moonbook",
  "version": "0.1.0",
  "display_name": "MoonBook Executable Knowledge and Bookkeeper",
  "product_id": "moonbook",
  "kind": "PlatformPack",
  "required_runtime_extensions": ["moonflow"],
  "book_templates": [],
  "schemas": [
    {
      "id": "bookkeeper-product-outcome-closure",
      "version": "1.0.0",
      "path": "schemas/bookkeeper-product-outcome-closure.schema.json"
    },
    {
      "id": "bookkeeper-product-outcome-closure-receipt",
      "version": "1.0.0",
      "path": "schemas/bookkeeper-product-outcome-closure-receipt.schema.json"
    },
    {
      "id": "wiki-requirements-prepare",
      "version": "1.0.0",
      "path": "schemas/wiki-requirements-prepare.schema.json"
    },
    {
      "id": "wiki-requirements-packet",
      "version": "1.0.0",
      "path": "schemas/wiki-requirements-packet.schema.json"
    }
  ],
  "tools": [
    {
      "id": "bookkeeper.outcome.close",
      "owner_product": "moonbook",
      "input_schema_id": "bookkeeper-product-outcome-closure",
      "output_schema_id": "bookkeeper-product-outcome-closure-receipt",
      "authority": "WorkspaceMutation",
      "idempotent": true,
      "evidence_outputs": [
        ".moonbook/bookkeeper/journal",
        ".moonbook/bookkeeper/snapshot.json",
        ".moonbook/bookkeeper/ui-state.json"
      ],
      "review_required": true
    },
    {
      "id": "wiki.requirements.prepare",
      "owner_product": "moonbook",
      "input_schema_id": "wiki-requirements-prepare",
      "output_schema_id": "wiki-requirements-packet",
      "authority": "WorkspaceMutation",
      "idempotent": true,
      "evidence_outputs": [
        "MoonFlow-requested workspace-relative requirements packet"
      ],
      "review_required": true
    }
  ],
  "workflows": [],
  "skills": [],
  "policies": [],
  "provider_ports": [],
  "schedules": [],
  "app_entrypoints": [],
  "migrations": [],
  "evaluations": [],
  "uninstall_contract": {
    "id": "moonbook-user-evidence-preservation",
    "version": "1.0.0",
    "path": "docs/EXECUTABLE_BOOK_BOUNDARY.md"
  }
}
