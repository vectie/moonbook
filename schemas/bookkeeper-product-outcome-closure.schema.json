{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonbook/bookkeeper-product-outcome-closure@1.0.0",
  "title": "MoonBook product outcome closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request",
    "source_product",
    "deliverable",
    "result",
    "deliverable_review",
    "observed_at",
    "recorded_at",
    "outcome_summary",
    "owner_route",
    "evidence_refs",
    "information_gap",
    "recognition_gap",
    "decisiveness_gap",
    "capability_id",
    "capability_version",
    "capability_change_digest",
    "capability_summary"
  ],
  "properties": {
    "contract_version": {
      "const": "moonbook.bookkeeper.product_outcome_closure.v1"
    },
    "request": { "$ref": "#/$defs/recordReference" },
    "source_product": { "type": "string", "minLength": 1 },
    "deliverable": { "$ref": "#/$defs/recordReference" },
    "result": { "$ref": "#/$defs/recordReference" },
    "deliverable_review": { "$ref": "#/$defs/recordReference" },
    "observed_at": { "type": "integer", "minimum": 0 },
    "recorded_at": { "type": "integer", "minimum": 0 },
    "outcome_summary": { "type": "string", "minLength": 1 },
    "owner_route": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceReference" }
    },
    "information_gap": { "$ref": "#/$defs/gapStatement" },
    "recognition_gap": { "$ref": "#/$defs/gapStatement" },
    "decisiveness_gap": { "$ref": "#/$defs/gapStatement" },
    "capability_id": { "type": "string", "minLength": 1 },
    "capability_version": { "type": "string", "minLength": 1 },
    "capability_change_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capability_summary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "recordReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_version", "record_digest"],
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "record_version": { "type": "string", "minLength": 1 },
        "record_digest": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "reference_version",
        "digest",
        "provenance_ref"
      ],
      "properties": {
        "reference_id": { "type": "string", "minLength": 1 },
        "reference_version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "provenance_ref": { "type": "string", "minLength": 1 }
      }
    },
    "gapStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "severity", "summary", "evidence_refs"],
      "properties": {
        "present": { "type": "boolean" },
        "severity": { "type": "integer", "minimum": 0, "maximum": 5 },
        "summary": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
