{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moonbook/wiki-requirements-prepare@1.0.0",
  "title": "MoonBook deterministic requirements preparation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request",
    "book_id",
    "goal",
    "owner_route",
    "recorded_at",
    "evidence_refs",
    "statements"
  ],
  "properties": {
    "contract_version": {
      "const": "moonbook.wiki.requirements_prepare.v1"
    },
    "request": { "$ref": "#/$defs/recordReference" },
    "book_id": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "owner_route": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "integer", "minimum": 0 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceReference" }
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceStatement" }
    }
  },
  "$defs": {
    "recordReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_version", "record_digest"],
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "record_version": { "type": "string", "minLength": 1 },
        "record_digest": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "reference_version",
        "digest",
        "provenance_ref"
      ],
      "properties": {
        "reference_id": { "type": "string", "minLength": 1 },
        "reference_version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "provenance_ref": { "type": "string", "minLength": 1 }
      }
    },
    "sourceStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement_id", "kind", "text", "evidence_refs"],
      "properties": {
        "statement_id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "fact",
            "calculation",
            "inference",
            "unresolved_question"
          ]
        },
        "text": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
